{
	"name": "PL_SEND_MAIL",
	"properties": {
		"activities": [
			{
				"name": "Read all tables status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.audit_log where adf_run_id='@{pipeline().parameters.adf_run_id}'\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sqlaz",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Prepare Email Header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body header",
					"value": {
						"value": "Ingestion and transformation process has been completed for care_sync project has been completed and below is the status",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare Email Footer body",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body header",
					"value": {
						"value": "For any support please contact azurepractice1k@gmail.com",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Email Subject",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Check overall failed count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "@{pipeline().globalParameters.env} |@{if(greater(activity('Check overall failed count').output.firstRow.counts,0),'FAIL','SUCCESS')}|CARE_SYNC MASTER RUN",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Check overall failed count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat(\n'SELECT COUNT(*) AS counts\nFROM ctrl.audit_log\nWHERE adf_run_id = ''',\npipeline().parameters.adf_run_id,\n''' AND status <> ''SUCCESS'''\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sqlaz",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Email Logic apps",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Prepare Email Header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare Email Footer body",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Read all tables status",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Email Subject",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\n    \"subject\":\"@{variables('email_subject')}\",\n    \"email_receipients\":\"@{pipeline().globalParameters.email_receipient}\",\n    \"body_header\":\"@{variables('body header')}\",\n    \"body_footer\":\"@{variables('footer')}\",\n    \"status_table\": @{activity('Read all tables status').output.value}\n",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Send Email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Email Logic apps",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-19.centralus.logic.azure.com:443/workflows/e9c52d2d706642c19ed95152120de364/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=J0Tjs5OvlkE9lnIQEeg-5dqWOKu0-u1yI0wV-i58HI0",
					"body": {
						"value": "@variables('logic_apps_body')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string",
				"defaultValue": "2eecebdb-be4e-47c0-99a6-2ecdb0b44329"
			}
		},
		"variables": {
			"body header": {
				"type": "String"
			},
			"footer": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"logic_apps_body": {
				"type": "String"
			}
		},
		"annotations": []
	}
}